{
  "format": "2",
  "runes": {
    "kb": {
      "name": "Knowledge base",
      "description": "Query knowledge bundles: what exists, what is in them, and their text",
      "vars": {
        "roots": [
          "docs/kb"
        ]
      },
      "run": {
        "command": "runes/kb.rune.js",
        "permissions": {
          "allow": [
            "fs.glob:docs/kb/**/*.md",
            "fs.read:docs/kb/**"
          ],
          "deny": []
        }
      }
    }
  }
}
