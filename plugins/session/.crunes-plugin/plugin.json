{
  "format": "1",
  "runes": {
    "session": {
      "name": "Session Reader",
      "description": "Discover and read Claude Code, Antigravity, and Codex session transcripts as Markdown",
      "run": {
        "command": "src/index.rune.js",
        "permissions": {
          "allow": [
            "fs.glob:~/.claude/projects::**/*.jsonl",
            "fs.glob:~/.gemini/antigravity/brain::**/transcript.jsonl",
            "fs.glob:~/.gemini/antigravity-cli/brain::**/transcript.jsonl",
            "fs.glob:~/.gemini/antigravity-ide/brain::**/transcript.jsonl",
            "fs.read:~/.claude/projects/**",
            "fs.read:~/.gemini/antigravity/brain/**",
            "fs.read:~/.gemini/antigravity-cli/brain/**",
            "fs.read:~/.gemini/antigravity-ide/brain/**",
            "fs.read:~/.gemini/antigravity/conversations/*",
            "fs.read:~/.gemini/antigravity-cli/conversations/*",
            "fs.read:~/.gemini/antigravity-ide/conversations/*",
            "sqlite.read:~/.gemini/antigravity/conversations::*",
            "sqlite.read:~/.gemini/antigravity-cli/conversations::*",
            "sqlite.read:~/.gemini/antigravity-ide/conversations::*",
            "fs.glob:~/.codex/sessions::**/*.jsonl",
            "fs.read:~/.codex/sessions/**",
            "fs.glob:~/.codex/archived_sessions::**/*.jsonl",
            "fs.glob:~/.codex/sessions::**/*.jsonl.zst",
            "fs.glob:~/.codex/archived_sessions::**/*.jsonl.zst",
            "fs.read:~/.codex/archived_sessions/**",
            "fs.read:~/.crunes/cache/**",
            "fs.write:~/.crunes/cache/**",
            "fs.read:**"
          ],
          "deny": []
        }
      }
    }
  }
}
